<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>HostTemplate.App</RootNamespace>
    <AssemblyName>HostTemplate</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\HostTemplate.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SunnyUI" Version="3.7.2" />
    <PackageReference Include="SunnyUI.Common" Version="3.7.2" />
    <PackageReference Include="log4net" Version="3.3.0" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HostTemplate.Core\HostTemplate.Core.csproj" />
    <ProjectReference Include="..\HostTemplate.Devices\HostTemplate.Devices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo-byd-shisibu.png">
      <LogicalName>HostTemplate.App.Assets.logo-byd-shisibu.png</LogicalName>
    </EmbeddedResource>
    <Content Include="Assets\HostTemplate.ico" Link="HostTemplate.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="bootstrap.default.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="templates\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
